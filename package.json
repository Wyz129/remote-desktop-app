{
  "name": "remote-desktop-demo",
  "displayName": "Remote Desktop Demo",
  "description": "Remote-SSH 桌面与多窗口资源管理器，支持远程文件操作和持久化快捷方式。",
  "version": "0.0.5",
  "publisher": "local-demo",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "桌面文件浏览可用；工作区终端和命令快捷方式需要信任工作区。"
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/build-assets.cjs",
    "check": "node --check extension.js && node --check remote-terminal.js && node --check media/desktop.js",
    "test:ui": "node --test test/ui.test.cjs",
    "test:backend": "node --test test/backend.test.cjs",
    "test:terminal": "node --test test/terminal.test.cjs",
    "test:vscode": "node scripts/test-vscode.cjs",
    "test": "npm run vscode:prepublish && npm run check && npm run test:backend && npm run test:terminal && npm run test:ui && npm run test:vscode",
    "package": "vsce package --allow-missing-repository --no-rewrite-relative-links --skip-license --out artifacts/remote-desktop-demo-0.0.5.vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "remoteDesktop.openDemo",
        "title": "Remote Desktop: Open Demo"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "remoteDesktop.openDemo",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Remote Desktop Demo",
      "properties": {
        "remoteDesktopDemo.openOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "启动 VS Code 时自动打开桌面；Remote-SSH 窗口读取服务器文件，本地窗口使用 Demo 数据。"
        },
        "remoteDesktopDemo.remoteRoot": {
          "type": "string",
          "default": "/home/demo",
          "description": "模拟远程根路径；双击资源时映射到当前 VS Code 工作区并交给 VS Code 打开。"
        },
        "remoteDesktopDemo.remoteHome": {
          "type": "string",
          "default": "",
          "description": "Remote-SSH 主目录的绝对路径；留空时在远程扩展主机读取登录用户主目录。"
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide": "^1.44.0",
    "playwright": "^1.63.0"
  }
}
