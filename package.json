{
  "name": "remote-desktop-app",
  "displayName": "Remote Desktop App",
  "description": "独立 SSH 文档工作台、服务器浏览器、传输中心与命令行实例",
  "version": "1.1.1",
  "private": true,
  "main": "./main.cjs",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/start-app.cjs",
    "dev": "node scripts/start-app.cjs --enable-logging",
    "check": "node scripts/check-syntax.cjs",
    "test:backend": "node --test test/standalone-backend.test.cjs test/desktop-service.test.cjs test/terminal-close.test.cjs test/server-clock.test.cjs test/desktop-preferences.test.cjs",
    "test:ui": "node --test test/standalone-ui.test.cjs",
    "test:vim": "node --test test/real-vim.test.cjs",
    "test:electron": "node --test test/electron.test.cjs",
    "test:modules": "node --test test/upload-service.test.cjs test/instance-bridge.test.cjs test/document-service.test.cjs test/jupyter-client.test.cjs test/ssh-network.test.cjs test/preview-server.test.cjs",
    "test:workbench": "node --test test/workbench-ui.test.cjs",
    "test:workspace": "node --test test/workspace-electron.test.cjs",
    "test:browser": "node --test test/browser-electron.test.cjs",
    "test:cli": "node --test test/cli-packaged.test.cjs",
    "test": "npm run check && npm run test:backend && npm run test:modules && npm run test:vim && npm run test:ui && npm run test:workbench && npm run test:electron && npm run test:workspace && npm run test:browser && npm run test:cli",
    "package": "electron-builder --dir",
    "assets:workbench": "node scripts/vendor-workbench.cjs",
    "postinstall": "npm run assets:workbench",
    "prepackage": "npm run assets:workbench",
    "cli": "node scripts/cli.cjs"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.0.12",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "katex": "^0.18.7",
    "marked": "^18.0.13",
    "monaco-editor": "^0.53.0",
    "ssh2": "^1.17.0",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.wyz.remote-desktop",
    "productName": "Remote Desktop",
    "directories": {
      "output": "artifacts/electron-1.1.1"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**/*",
      "app/**/*",
      "media/lucide*",
      "media/xterm*",
      "package.json",
      "workbench-preload.cjs",
      "browser-preload.cjs",
      "media/workbench/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": "dir"
    },
    "extraResources": [
      {
        "from": "scripts/cli.cjs",
        "to": "cli/scripts/cli.cjs"
      },
      {
        "from": "scripts/rdesktop.cmd",
        "to": "cli/scripts/rdesktop.cmd"
      },
      {
        "from": "lib/instance-bridge.cjs",
        "to": "cli/lib/instance-bridge.cjs"
      }
    ]
  }
}
