{
  "name": "remote-desktop-app",
  "displayName": "Remote Desktop App",
  "description": "独立 Remote Desktop 应用：通过 SSH 浏览远程桌面并下载文件。",
  "version": "1.0.1",
  "private": true,
  "main": "./main.cjs",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/start-app.cjs",
    "dev": "node scripts/start-app.cjs --enable-logging",
    "check": "node --check main.cjs && node --check preload.cjs && node --check lib/ssh-backend.cjs && node --check lib/desktop-service.cjs && node --check lib/terminal-guard.cjs && node --check app/desktop.js",
    "test:backend": "node --test test/standalone-backend.test.cjs test/desktop-service.test.cjs test/terminal-close.test.cjs",
    "test:ui": "node --test test/standalone-ui.test.cjs",
    "test:vim": "node --test test/real-vim.test.cjs",
    "test:electron": "node --test test/electron.test.cjs",
    "test": "npm run check && npm run test:backend && npm run test:vim && npm run test:ui && npm run test:electron",
    "package": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.0.12",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "build": {
    "appId": "com.wyz.remote-desktop",
    "productName": "Remote Desktop",
    "directories": {
      "output": "artifacts/electron-1.0.1"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**/*",
      "app/**/*",
      "media/lucide*",
      "media/xterm*",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "target": "dir"
    }
  }
}
